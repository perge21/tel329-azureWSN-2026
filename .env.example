# Copiar a ".env" y completar. NUNCA subir ".env" a GitHub.

# --- Middleware (Paso 4): connection string del DISPOSITIVO ---
# Portal: IoT Hub > Device management > Devices > contiki-ng-01 > Primary connection string
DEVICE_CONNECTION_STRING=HostName=tel329-g9-iothub.azure-devices.net;DeviceId=contiki-ng-01;SharedAccessKey=<CLAVE_DEL_DISPOSITIVO>

# Direccion del mote sensor. Mote ID 2 en Cooja -> fd00::202:2:2:2
SENSOR_URL=http://[fd00::202:2:2:2]/
POLL_MS=3000
DEVICE_ID=contiki-ng-01
PORT=3000

# --- Suscriptor (Paso 7): politica "service" del Hub ---
# Portal: IoT Hub > Security settings > Shared access policies > service > Connection string-primary key
IOTHUB_SERVICE_CONNECTION_STRING=HostName=tel329-g9-iothub.azure-devices.net;SharedAccessKeyName=service;SharedAccessKey=<CLAVE_POLITICA_SERVICE>

# Endpoint compatible con Event Hubs (IoT Hub > Hub settings > Built-in endpoints). No son secretos.
EVENTHUB_ENDPOINT=sb://ihsuprodcqres010dednamespace.servicebus.windows.net/
EVENTHUB_NAME=iothub-ehub-tel329-g9-58408324-2d489865c8
